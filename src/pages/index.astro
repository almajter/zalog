---
import { Image } from 'astro:assets'
import { band, parking, slug, walls } from '../walls'
import '@fontsource/big-shoulders-display/800'
import '@fontsource/public-sans/400'
import '@fontsource/public-sans/600'
---

<html lang="sl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Nenatančen vodniček Zaloga</title>
  <script is:inline>navigator.serviceWorker?.register('/sw.js')</script>
</head>
<body>
  <header>
    <h1>Nenatančen vodniček Zaloga</h1>
    <p class="sub">po <s>slabem</s> spominu</p>
    <p>Linije so narisane na pamet, imena in ocene tudi.</p>
    <button class="save" onclick="print()">Shrani PDF</button>
  </header>

  <section class="approach">
    <h2>Dostop</h2>
    <p class="links">
      <span>Parkirišče <code>{parking}</code></span>
      <a href="https://www.openstreetmap.org/?mlat=46.06178&mlon=14.63783#map=17/46.06178/14.63783">OpenStreetMap</a>
      <a href={`https://www.google.com/maps?q=${parking}`}>Google Maps</a>
    </p>
  </section>

  {walls.map(wall => (
    <section class="wall">
      <a href={wall.photo.src}>
        <Image src={wall.photo} alt={`Stena ${wall.name} z vrisanimi linijami`} width={1200} widths={[600, 1200]} quality={60} sizes="(max-width: 760px) 100vw, 45vw" />
      </a>
      <div>
        <h2>{wall.name}</h2>
        <a class="save" href={`/topo/${slug(wall.name)}.jpg`} download={`zalog-${slug(wall.name)}.jpg`}>Shrani sliko</a>
        <ol>
          {wall.problems.map(p => (
            <li class={p.num ? '' : 'variant'}>
              {p.num && <span class="num">{p.num}</span>}
              <div>
                <b class={p.name ? '' : 'unnamed'}>{p.name ?? 'brez imena'}</b>
                {p.note && <p>{p.note}</p>}
              </div>
              {p.grade && <span class={`grade ${band(p.grade)}`}>{p.grade}</span>}
            </li>
          ))}
        </ol>
      </div>
    </section>
  ))}

  <footer>Ocene so po Fontainebleau lestvici. Ko stran enkrat odpreš, deluje tudi brez signala.</footer>

  <script>
    // On phones a plain download lands in Files, the share sheet has "Save Image" which goes to the gallery
    const phone = matchMedia('(pointer: coarse)').matches
      && navigator.canShare?.({ files: [new File([''], 'x.jpg', { type: 'image/jpeg' })] })
    if (phone) document.querySelectorAll<HTMLAnchorElement>('a[download]').forEach(a => a.onclick = async e => {
      e.preventDefault()
      const blob = await fetch(a.href).then(r => r.blob())
      navigator.share({ files: [new File([blob], a.download, { type: blob.type })] }).catch(() => {})
    })
  </script>
</body>
</html>

<style is:global>
  :root {
    --bg: #eef0ea; --fg: #1f2420; --muted: #5d665e; --line: #d3d8cf; --red: #e5322d;
    --easy: #2f8a4c; --mid: #2c6bb3; --hard: #d97a10; --max: #8e1c3a;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #161a17; --fg: #e6eae3; --muted: #9aa499; --line: #333b34; --red: #ff5a4f; color-scheme: dark; }
  }

  body { max-width: 1100px; margin: 0 auto; padding: 0 16px 48px; background: var(--bg); color: var(--fg); font: 15px/1.55 'Public Sans', system-ui, sans-serif; }
  h1, h2 { font-family: 'Big Shoulders Display', Impact, sans-serif; text-transform: uppercase; line-height: 1; margin: 0; }
  h1 { font-size: clamp(44px, 9vw, 88px); }
  h2 { font-size: 36px; }
  a { color: inherit; }
  header { padding: 40px 0 24px; border-bottom: 3px solid var(--fg); }
  header p { color: var(--muted); max-width: 60ch; }
  .sub { font-size: 22px; margin: 6px 0 0; }
  .sub s { text-decoration-color: var(--red); text-decoration-thickness: 3px; }

  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; margin: 12px 0 0; }
  code { padding: 2px 6px; border-radius: 4px; background: var(--line); }
  .save { display: inline-block; margin-top: 12px; padding: 6px 14px; border: 1.5px solid var(--fg); border-radius: 4px; background: none; color: var(--fg); font: 600 14px 'Public Sans', sans-serif; text-decoration: none; cursor: pointer; }
  .save:hover { background: var(--fg); color: var(--bg); }
  .approach, .wall { padding: 32px 0; border-bottom: 1px solid var(--line); }
  .wall { display: grid; grid-template-columns: 5fr 6fr; gap: 32px; align-items: start; }
  .wall img { width: 100%; height: auto; border-radius: 4px; }

  ol { list-style: none; padding: 0; margin: 16px 0 0; }
  li { display: grid; grid-template-columns: 40px 1fr auto; gap: 14px; padding: 12px 0; border-top: 1px solid var(--line); }
  li.variant { grid-template-columns: 1fr auto; padding-left: 54px; }
  li p { margin: 2px 0 0; color: var(--muted); font-size: 14px; }
  .unnamed { font-weight: 400; font-style: italic; color: var(--muted); }
  .num { width: 34px; height: 34px; border: 2.5px solid var(--red); border-radius: 50%; color: var(--red); text-align: center; font: 800 18px/29px 'Big Shoulders Display', sans-serif; }
  .grade { align-self: start; min-width: 52px; padding: 5px 8px; border-radius: 4px; color: #fff; text-align: center; font-weight: 600; }
  .easy { background: var(--easy); } .mid { background: var(--mid); } .hard { background: var(--hard); } .max { background: var(--max); }
  .none { color: var(--muted); border: 1px dashed var(--line); }

  footer { padding-top: 24px; color: var(--muted); font-size: 13px; }

  @media (max-width: 760px) { .wall { grid-template-columns: 1fr; } }

  /* Print / save as PDF: light colours, keep grade badges, one wall never split across pages */
  @page { margin: 12mm; }
  @media print {
    :root { --bg: #fff; --fg: #000; --muted: #444; --line: #ccc; color-scheme: light; }
    * { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    body { max-width: none; padding: 0; font-size: 12px; }
    header { padding-top: 0; }
    .links a, .save { display: none; }
    .approach, .wall { padding: 16px 0; }
    .wall { grid-template-columns: 5fr 6fr; gap: 20px; break-inside: avoid; }
    li { padding: 6px 0; }
    li p { font-size: 11px; }
  }
</style>
